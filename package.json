{
  "name": "teststeady-playwright-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright regression suite for a public demo store: page objects, 3 browsers, CI and HTML reports.",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22",
    "typescript": "^5"
  }
}
